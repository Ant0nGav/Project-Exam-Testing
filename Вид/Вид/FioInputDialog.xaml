<Window x:Class="Вид.FioInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Вид"
        mc:Ignorable="d"
        Title="Создание варианта для участника" 
        Height="690" 
        Width="700"
        WindowStartupLocation="CenterOwner"
        Icon="/LogoDemidovskiyUniversitet.ico">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        
        <Label Grid.Row="0" Content="ФИО участника:" Margin="0,0,0,5"/>
        <TextBox x:Name="txtFullName" Grid.Row="1" Margin="0,0,0,10" Height="25" TextChanged="txtFullName_TextChanged" PreviewTextInput="txtFullName_PreviewTextInput"
         DataObject.Pasting="txtFullName_Pasting"
         MaxLength="100"/>

        
        <Label Grid.Row="2" Content="Путь к папке с вариантами:" Margin="0,0,0,5"/>
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="txtVariantsPath" Grid.Column="0" Height="25" IsReadOnly="True"/>
            <Button x:Name="btnBrowseVariants" Grid.Column="1" Content="Обзор..." 
                    Margin="5,0,0,0" Width="80" Click="btnBrowseVariants_Click"/>
        </Grid>

        
        <Label Grid.Row="4" Content="Выберите вариант:" Margin="0,0,0,5"/>
        <ComboBox x:Name="cmbVariants" Grid.Row="5" Margin="0,0,0,15" Height="25"/>


        <Label Grid.Row="8" Content="Лог выполнения:" Margin="0,75,0,0" HorizontalAlignment="Left" Width="622" Height="27" VerticalAlignment="Top"/>
        <TextBox x:Name="txtLog" Grid.Row="8" Margin="0,124,0,80" IsReadOnly="True" 
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextWrapping="Wrap" Grid.RowSpan="2"/>

        
        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,135,0,-5" RenderTransformOrigin="0.524,0.303">
            <Button x:Name="btnCreate" Content="Создать" Width="100" Height="30" 
                    Margin="0,0,10,0" Click="btnCreate_Click"/>
            <Button x:Name="btnCancel" Content="Отмена" Width="100" Height="30" 
                    Click="btnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
