<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="Вид.Window2"
        Title="Создание варианта" Height="650" Width="1000"
        Background="#FEFEFE" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- Основная прокручиваемая область -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
            <StackPanel x:Name="TasksPanel" >
                <!-- Пример одной строки -->
                <Border BorderBrush="#2D6DFE" BorderThickness="2" CornerRadius="10" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <!-- № -->
                        <TextBlock Text="1" VerticalAlignment="Center" FontSize="18" RenderTransformOrigin="0.995,0.462" Grid.ColumnSpan="2" Margin="20,0,100,0"/>

                        <!-- Задача -->
                        <Button Grid.Column="1" Content="+" Width="35" Height="35"
                                Background="#FEFEFE" BorderBrush="#2D6DFE" BorderThickness="2"
                                Foreground="#2D6DFE" FontSize="20" FontWeight="Bold" Margin="33,0,52,0"/>

                        <!-- Тип задания -->
                        <TextBox Grid.Column="2" Text="&lt;" FontSize="20" HorizontalContentAlignment="Center" Grid.ColumnSpan="2" Margin="0,0,86,0"/>

                        <!-- Ответ -->
                        <TextBox Grid.Column="3" Text="0" FontSize="20" HorizontalContentAlignment="Center" Margin="86,4,0,4"/>

                        <!-- Файл -->
                        <Button Grid.Column="4" Content="+" Width="35"
                                Background="#FEFEFE" BorderBrush="#2D6DFE" BorderThickness="2"
                                Foreground="#2D6DFE" FontSize="20" FontWeight="Bold" Margin="42,3,42,3"/>

                        <!-- Баллы -->
                        <TextBlock Grid.Column="5" Text="1" VerticalAlignment="Center" FontSize="18"/>

                        <!-- Удалить -->
                        <Button Grid.Column="6" Content="X" Width="35" Height="35"
                                Background="#FEFEFE" BorderBrush="#D1001F" BorderThickness="2"
                                Foreground="#D1001F" FontSize="18" FontWeight="Bold"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Правая панель -->
        <Border Grid.Column="1" Background="#2D6DFE" Padding="20">
            <StackPanel >

                <TextBlock Text="Создание варианта" FontSize="28" FontWeight="Bold" Foreground="White" TextAlignment="Center"/>

                <!-- Время экзамена -->
                <StackPanel>
                    <TextBlock Text="Время экзамена" FontSize="18" Foreground="White" Margin="0 0 0 5"/>
                    <ToggleButton x:Name="ExamTimeToggle" Content="Вкл / Выкл" Height="30"/>
                    <TextBlock Text="00:00" Foreground="White" FontSize="16" Margin="0 5 0 0"/>
                </StackPanel>

                <!-- Предупреждение -->
                <StackPanel>
                    <TextBlock Text="Предупреждение" FontSize="18" Foreground="White" Margin="0 0 0 5"/>
                    <ToggleButton x:Name="WarningToggle" Content="Вкл / Выкл" Height="30"/>
                    <TextBlock Text="00:00" Foreground="White" FontSize="16" Margin="0 5 0 0"/>
                </StackPanel>

                <!-- Инструкция + Справка -->
                <Button Content="Инструкция" Height="40" Background="White" Foreground="#2D6DFE"/>
                <Button Content="Справка" Height="40" Background="White" Foreground="#2D6DFE"/>

                <!-- Кнопки сохранить -->
                <Button Content="Сохранить для преподавателя" Height="50" Background="White" Foreground="#2D6DFE" FontSize="16"/>
                <Button Content="Сохранить для учеников" Height="50" Background="White" Foreground="#2D6DFE" FontSize="16"/>
                <Button Content="Главное меню" Height="50" Background="White" Foreground="#2D6DFE" FontSize="16"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

